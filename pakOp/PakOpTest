long duration;
int distance;

const int RIGHT_BACKWARD = 10;
const int RIGHT_FORWARD = 9;
const int ULTRA_SONIC_TRIG = 8;
const int ULTRA_SONIC_ECHO = 7;
const int LEFT_BACKWARD = 6;
const int LEFT_FORWARD = 5;
const int RIGHT_IN = 2;
const int LEFT_IN = 3;
const int GRIPPER = 11;

const byte WHEEL_SPEED = 255;

const int DETECT_DISTANCE = 7;
const int PULSES_25_CM = 50;

int rightPulses = 0;
int lastInterruptRight = 0;
int leftPulses = 0;
int lastInterruptLeft = 0;

int rightWheel;
int leftWheel;

unsigned long lastServoPulse = 0;
int servoPulseWidth = 1500;

int stepNumber = 0;
unsigned long stepStartTime = 0;
bool stepStarted = false;


// Zet alle pins klaar en zet outputs LOW zodat motors niet meteen starten
void setup() {
  pinMode(ULTRA_SONIC_TRIG, OUTPUT);
  pinMode(ULTRA_SONIC_ECHO, INPUT);
  pinMode(RIGHT_BACKWARD, OUTPUT);
  pinMode(RIGHT_FORWARD, OUTPUT);
  pinMode(LEFT_BACKWARD, OUTPUT);
  pinMode(LEFT_FORWARD, OUTPUT);
  pinMode(GRIPPER, OUTPUT);
  pinMode(RIGHT_IN, INPUT);
  pinMode(LEFT_IN, INPUT);

  digitalWrite(ULTRA_SONIC_TRIG, LOW);
  digitalWrite(RIGHT_BACKWARD, LOW);
  digitalWrite(RIGHT_FORWARD, LOW);
  digitalWrite(LEFT_BACKWARD, LOW);
  digitalWrite(LEFT_FORWARD, LOW);
  digitalWrite(GRIPPER, LOW);

  Serial.begin(9600);

  attachInterrupt(digitalPinToInterrupt(RIGHT_IN), countPulseRightWheel, RISING);
  attachInterrupt(digitalPinToInterrupt(LEFT_IN), countPulseLeftWheel, RISING);

  clawOpen(true);
}


// Houdt servo actief en voert het stappenplan uit
void loop() {
  updateServo();
  runSteps();
}


// Telt rechter encoderpulsen met debounce van 20 ms
void countPulseRightWheel() {

  // alleen tellen als debounce tijd voorbij is
  if (millis() > lastInterruptRight) {
    rightPulses++;
    lastInterruptRight = millis() + 20;
  }
}


// Telt linker encoderpulsen met debounce van 20 ms
void countPulseLeftWheel() {

  // voorkomt dubbele pulsen door sensor bounce
  if (millis() > lastInterruptLeft) {
    leftPulses++;
    lastInterruptLeft = millis() + 20;
  }
}


// Stuurt alle robot stappen (grijper + rijden)
void runSteps() {
  switch (stepNumber) {

    case 0:
      startStep();
      clawOpen(true);

      // wacht 1 seconde zodat servo kan bewegen
      if (millis() - stepStartTime >= 1000) {
        nextStep();
      }
      break;

    case 1:
      startStep();
      clawOpen(false);

      // wacht opnieuw 1 seconde
      if (millis() - stepStartTime >= 1000) {
        nextStep();
      }
      break;

    case 2:
      startStep();
      clawOpen(true);

      // opnieuw 1 seconde wachten
      if (millis() - stepStartTime >= 1000) {
        nextStep();
      }
      break;

    case 3:
      startStep();

      // rijdt vooruit tot object of afstand bereikt
      if (driveUntilConeOrDistance(PULSES_25_CM, PULSES_25_CM)) {
        nextStep();
      }
      break;

    case 4:
      startStep();
      clawOpen(false);

      // wacht zodat grijper kan sluiten
      if (millis() - stepStartTime >= 1000) {
        nextStep();
      }
      break;

    case 5:
      startStep();

      // rijdt vaste afstand
      if (driveFixedDistance(PULSES_25_CM, PULSES_25_CM)) {
        nextStep();
      }
      break;

    case 6:
      clawOpen(false);
      stopMotors();
      break;
  }
}


// Start een stap maar één keer en slaat de starttijd op
void startStep() {

  // voorkomt dat de tijd steeds opnieuw wordt gezet
  if (!stepStarted) {
    stepStarted = true;
    stepStartTime = millis();
  }
}


// Gaat naar de volgende stap
void nextStep() {
  stepNumber++;
  stepStarted = false;
}


// Rijdt vooruit tot object (7 cm) of afstand (50 pulsen ≈25 cm)
bool driveUntilConeOrDistance(int rightDistance, int leftDistance) {
  static bool started = false;

  // reset encoder pulsen bij start beweging
  if (!started) {
    rightPulses = 0;
    leftPulses = 0;
    started = true;
  }

  rightWheel = RIGHT_FORWARD;
  leftWheel = LEFT_FORWARD;

  int currentDistance = ultraSonicSensor();
  Serial.println(currentDistance);

  // stop als object dichter dan 7 cm is
  if (currentDistance <= DETECT_DISTANCE) {
    stopMotors();
    started = false;
    rightPulses = 0;
    leftPulses = 0;
    return true;
  }

  // rechter wiel rijdt tot afstand bereikt
  if (rightPulses < rightDistance) {
    analogWrite(rightWheel, WHEEL_SPEED);
  } else {
    analogWrite(rightWheel, 0);
  }

  // linker wiel rijdt tot afstand bereikt
  if (leftPulses < leftDistance) {
    analogWrite(leftWheel, WHEEL_SPEED);
  } else {
    analogWrite(leftWheel, 0);
  }

  // corrigeert als linker wiel sneller draait
  if (leftPulses > rightPulses && rightPulses < rightDistance) {
    analogWrite(rightWheel, WHEEL_SPEED / 2);
  }

  // corrigeert als rechter wiel sneller draait
  if (rightPulses > leftPulses && leftPulses < leftDistance) {
    analogWrite(leftWheel, WHEEL_SPEED / 2);
  }

  // stop als beide wielen doelafstand bereikt hebben
  if (rightPulses >= rightDistance && leftPulses >= leftDistance) {
    stopMotors();
    started = false;
    rightPulses = 0;
    leftPulses = 0;
    return true;
  }

  return false;
}


// Rijdt vaste afstand met encoder pulsen
bool driveFixedDistance(int rightDistance, int leftDistance) {
  static bool started = false;

  // reset encoders bij start
  if (!started) {
    rightPulses = 0;
    leftPulses = 0;
    started = true;
  }

  rightWheel = RIGHT_FORWARD;
  leftWheel = LEFT_FORWARD;

  // rechter wiel rijdt tot afstand bereikt
  if (rightPulses < rightDistance) {
    analogWrite(rightWheel, WHEEL_SPEED);
  } else {
    analogWrite(rightWheel, 0);
  }

  // linker wiel rijdt tot afstand bereikt
  if (leftPulses < leftDistance) {
    analogWrite(leftWheel, WHEEL_SPEED);
  } else {
    analogWrite(leftWheel, 0);
  }

  // correctie als linker wiel sneller
  if (leftPulses > rightPulses && rightPulses < rightDistance) {
    analogWrite(rightWheel, WHEEL_SPEED / 2);
  }

  // correctie als rechter wiel sneller
  if (rightPulses > leftPulses && leftPulses < leftDistance) {
    analogWrite(leftWheel, WHEEL_SPEED / 2);
  }

  // stop als beide wielen afstand hebben gehaald
  if (rightPulses >= rightDistance && leftPulses >= leftDistance) {
    stopMotors();
    started = false;
    rightPulses = 0;
    leftPulses = 0;
    return true;
  }

  return false;
}


// Zet alle motoren uit
void stopMotors() {
  analogWrite(RIGHT_FORWARD, 0);
  analogWrite(RIGHT_BACKWARD, 0);
  analogWrite(LEFT_FORWARD, 0);
  analogWrite(LEFT_BACKWARD, 0);
}


// Meet afstand met ultrasoon sensor
int ultraSonicSensor() {
  static unsigned long lastActive = 0;

  // voorkomt dat sensor vaker dan elke 100 ms meet
  if (millis() < lastActive) {
    return distance;
  }

  digitalWrite(ULTRA_SONIC_TRIG, LOW);
  delayMicroseconds(2);

  digitalWrite(ULTRA_SONIC_TRIG, HIGH);
  delayMicroseconds(10);
  digitalWrite(ULTRA_SONIC_TRIG, LOW);

  duration = pulseIn(ULTRA_SONIC_ECHO, HIGH, 25000);

  // geen echo ontvangen dus buiten bereik
  if (duration == 0) {
    return 999;
  }

  distance = duration * 0.034 / 2;
  lastActive = millis() + 100;

  return distance;
}


// Stuurt servo puls elke 20 ms
void updateServo() {

  // servo verwacht elke ~20 ms een puls
  if (millis() - lastServoPulse >= 20) {
    lastServoPulse = millis();
    digitalWrite(GRIPPER, HIGH);
    delayMicroseconds(servoPulseWidth);
    digitalWrite(GRIPPER, LOW);
  }
}


// Zet servo positie open of dicht
void clawOpen(bool open) {

  // open positie
  if (open) {
    servoPulseWidth = 1500;
  } else {

    // gesloten positie
    servoPulseWidth = 1100;
  }
}
