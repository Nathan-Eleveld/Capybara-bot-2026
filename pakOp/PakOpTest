long duration;
int distance;

const int RIGHT_BACKWARD = 10;
const int RIGHT_FORWARD = 9;
const int ULTRA_SONIC_TRIG = 8;
const int ULTRA_SONIC_ECHO = 7;
const int LEFT_BACKWARD = 6;
const int LEFT_FORWARD = 5;
const int RIGHT_IN = 2;
const int LEFT_IN = 3;
const int GRIPPER = 11;

const byte WHEEL_SPEED = 255;
const byte SEARCH_SPEED = 255;

const int DETECT_DISTANCE = 7;
const int PULSES_25_CM = 50;

volatile int rightPulses = 0;
volatile int lastInterruptRight = 0;
volatile int leftPulses = 0;
volatile int lastInterruptLeft = 0;

int rightWheel;
int leftWheel;

unsigned long lastServoPulse = 0;
int servoPulseWidth = 1500;

int stepNumber = 0;
unsigned long stepStartTime = 0;
bool stepStarted = false;

// Zet pins goed klaar, zet outputs eerst LOW zodat motors/servo niet direct starten.
void setup() {
  pinMode(ULTRA_SONIC_TRIG, OUTPUT);
  pinMode(ULTRA_SONIC_ECHO, INPUT);
  pinMode(RIGHT_BACKWARD, OUTPUT);
  pinMode(RIGHT_FORWARD, OUTPUT);
  pinMode(LEFT_BACKWARD, OUTPUT);
  pinMode(LEFT_FORWARD, OUTPUT);
  pinMode(GRIPPER, OUTPUT);
  pinMode(RIGHT_IN, INPUT);
  pinMode(LEFT_IN, INPUT);

  digitalWrite(ULTRA_SONIC_TRIG, LOW);
  digitalWrite(RIGHT_BACKWARD, LOW);
  digitalWrite(RIGHT_FORWARD, LOW);
  digitalWrite(LEFT_BACKWARD, LOW);
  digitalWrite(LEFT_FORWARD, LOW);
  digitalWrite(GRIPPER, LOW);

  Serial.begin(9600);

  attachInterrupt(digitalPinToInterrupt(RIGHT_IN), countPulseRightWheel, RISING);
  attachInterrupt(digitalPinToInterrupt(LEFT_IN), countPulseLeftWheel, RISING);

  clawOpen(true);
}

// Houd servo actief en voert steeds de volgende stap uit.
void loop() {
  updateServo();
  runSteps();
}

// Telt rechter encoderpulsen. +20 ms blokkeert dubbele metingen door storing/bounce.
void countPulseRightWheel() {
  if (millis() > lastInterruptRight) {
    rightPulses++;
    lastInterruptRight = millis() + 20;
  }
}

// Telt linker encoderpulsen. +20 ms blokkeert dubbele metingen door storing/bounce.
void countPulseLeftWheel() {
  if (millis() > lastInterruptLeft) {
    leftPulses++;
    lastInterruptLeft = millis() + 20;
  }
}

// Stuurt het hele stappenplan aan: grijper openen/sluiten en rijden per fase.
void runSteps() {
  switch (stepNumber) {
    case 0:
      startStep();
      clawOpen(true);

      if (millis() - stepStartTime >= 1000) {
        nextStep();
      }
      break;

    case 1:
      startStep();
      clawOpen(false);

      if (millis() - stepStartTime >= 1000) {
        nextStep();
      }
      break;

    case 2:
      startStep();
      clawOpen(true);

      if (millis() - stepStartTime >= 1000) {
        nextStep();
      }
      break;

    case 3:
      startStep();

      if (driveUntilConeOrDistance(PULSES_25_CM, PULSES_25_CM)) {
        nextStep();
      }
      break;

    case 4:
      startStep();
      clawOpen(false);

      if (millis() - stepStartTime >= 1000) {
        nextStep();
      }
      break;

    case 5:
      startStep();

      if (driveFixedDistance(PULSES_25_CM, PULSES_25_CM)) {
        nextStep();
      }
      break;

    case 6:
      clawOpen(false);
      stopMotors();
      break;
  }
}

// Start een stap maar één keer en bewaart de begintijd voor timing.
void startStep() {
  if (!stepStarted) {
    stepStarted = true;
    stepStartTime = millis();
  }
}

// Gaat naar de volgende stap en reset de startstatus van de huidige stap.
void nextStep() {
  stepNumber++;
  stepStarted = false;
}

// Rijdt vooruit tot een object op 7 cm is gevonden of tot 50 pulsen ≈ 25 cm zijn gereden.
bool driveUntilConeOrDistance(int rightDistance, int leftDistance) {
  static bool started = false;

  if (!started) {
    rightPulses = 0;
    leftPulses = 0;
    started = true;
  }

  rightWheel = RIGHT_FORWARD;
  leftWheel = LEFT_FORWARD;

  int currentDistance = ultraSonicSensor();
  Serial.println(currentDistance);

  if (currentDistance <= DETECT_DISTANCE) {
    stopMotors();
    started = false;
    rightPulses = 0;
    leftPulses = 0;
    return true;
  }

  if (rightPulses < rightDistance) {
    analogWrite(rightWheel, SEARCH_SPEED);
  } else {
    analogWrite(rightWheel, 0);
  }

  if (leftPulses < leftDistance) {
    analogWrite(leftWheel, SEARCH_SPEED);
  } else {
    analogWrite(leftWheel, 0);
  }

  if (leftPulses > rightPulses && rightPulses < rightDistance) {
    analogWrite(rightWheel, SEARCH_SPEED / 2);
  }

  if (rightPulses > leftPulses && leftPulses < leftDistance) {
    analogWrite(leftWheel, SEARCH_SPEED / 2);
  }

  if (rightPulses >= rightDistance && leftPulses >= leftDistance) {
    stopMotors();
    started = false;
    rightPulses = 0;
    leftPulses = 0;
    return true;
  }

  return false;
}

// Rijdt een vaste afstand met encoders. 50 pulsen is hier ingesteld als ongeveer 25 cm.
bool driveFixedDistance(int rightDistance, int leftDistance) {
  static bool started = false;

  if (!started) {
    rightPulses = 0;
    leftPulses = 0;
    started = true;
  }

  rightWheel = RIGHT_FORWARD;
  leftWheel = LEFT_FORWARD;

  if (rightPulses < rightDistance) {
    analogWrite(rightWheel, WHEEL_SPEED);
  } else {
    analogWrite(rightWheel, 0);
  }

  if (leftPulses < leftDistance) {
    analogWrite(leftWheel, WHEEL_SPEED);
  } else {
    analogWrite(leftWheel, 0);
  }

  if (leftPulses > rightPulses && rightPulses < rightDistance) {
    analogWrite(rightWheel, WHEEL_SPEED / 2);
  }

  if (rightPulses > leftPulses && leftPulses < leftDistance) {
    analogWrite(leftWheel, WHEEL_SPEED / 2);
  }

  if (rightPulses >= rightDistance && leftPulses >= leftDistance) {
    stopMotors();
    started = false;
    rightPulses = 0;
    leftPulses = 0;
    return true;
  }

  return false;
}

// Zet alle motoraansturing uit zodat de robot direct stopt.
void stopMotors() {
  analogWrite(RIGHT_FORWARD, 0);
  analogWrite(RIGHT_BACKWARD, 0);
  analogWrite(LEFT_FORWARD, 0);
  analogWrite(LEFT_BACKWARD, 0);
}

// Meet afstand met ultrasoon sensor. Timeout 25000 voorkomt te lang wachten, 100 ms beperkt spam. 999 is voor geen echo / buiten bereik
int ultraSonicSensor() {
  static unsigned long lastActive = 0;

  if (millis() < lastActive) {
    return distance;
  }

  digitalWrite(ULTRA_SONIC_TRIG, LOW);
  delayMicroseconds(2);

  digitalWrite(ULTRA_SONIC_TRIG, HIGH);
  delayMicroseconds(10);
  digitalWrite(ULTRA_SONIC_TRIG, LOW);

  duration = pulseIn(ULTRA_SONIC_ECHO, HIGH, 25000);

  if (duration == 0) {
    return 999;
  }

  distance = duration * 0.034 / 2;
  lastActive = millis() + 100;

  return distance;
}

// Houdt de servo actief met elke 20 ms een puls.
void updateServo() {
  if (millis() - lastServoPulse >= 20) {
    lastServoPulse = millis();
    digitalWrite(GRIPPER, HIGH);
    delayMicroseconds(servoPulseWidth);
    digitalWrite(GRIPPER, LOW);
  }
}

// Zet servo op open of dicht. 1500 is neutraal/open en 1100 trekt verder dicht.
void clawOpen(bool open) {
  if (open) {
    servoPulseWidth = 1500;
  } else {
    servoPulseWidth = 1100;
  }
}
